rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/staffs/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staffs/$(request.auth.uid)).data.role == 'Administrator'
        )
      );
    }

    function isActiveStaff() {
      return signedIn() &&
        exists(/databases/$(database)/documents/staffs/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/staffs/$(request.auth.uid)).data.status == 'active';
    }

    function isReaderDevice() {
      return signedIn() &&
        exists(/databases/$(database)/documents/devices/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/devices/$(request.auth.uid)).data.enabled == true;
    }

    match /staffs/{staffId} {
      allow read: if signedIn();
      allow create: if isAdministrator() && request.resource.data.uid == staffId;
      allow update: if (isAdministrator() && request.resource.data.uid == resource.data.uid) ||
        (signedIn() && staffId == request.auth.uid &&
          request.resource.data.uid == resource.data.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['emailVerified']) &&
          request.resource.data.emailVerified == true &&
          request.auth.token.email_verified == true);
      allow delete: if false;
    }

    // Username login reads one exact alias document; collection listing stays blocked.
    match /loginAliases/{username} {
      allow get: if true;
      allow list: if false;
      allow create, update, delete: if isAdministrator();
    }

    match /patients/{patientId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if false;
    }

    match /counters/{counterId} {
      allow read, create, update: if isActiveStaff();
      allow delete: if false;
    }

    match /scanControl/current {
      allow read: if isActiveStaff() || isReaderDevice();
      allow create, update, delete: if isActiveStaff();
    }

    match /pendingScan/current {
      allow read, delete: if isActiveStaff();
      allow create, update: if isReaderDevice();
    }

    match /readerStatus/current {
      allow read: if isActiveStaff();
      allow create, update: if isReaderDevice();
      allow delete: if false;
    }
  }
}
