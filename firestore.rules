rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdministrator() {
      return signedIn() && (
        request.auth.token.admin == true ||
        (
          exists(/databases/$(database)/documents/staff/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/staff/$(request.auth.uid)).data.role == 'Administrator'
        )
      );
    }

    match /staff/{staffId} {
      allow read: if signedIn();
      allow create: if isAdministrator() && request.resource.data.uid == staffId;
      allow update: if isAdministrator() && request.resource.data.uid == resource.data.uid;
      allow delete: if false;
    }
  }
}
